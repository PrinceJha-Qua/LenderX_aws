{
  "name": "lenderx",
  "version": "0.1.0",
  "private": true,
  "description": "LenderX — The Global Arbitrage Lending Bridge",
  "license": "MIT",
  "workspaces": [
    "infra",
    "backend",
    "frontend-lender",
    "frontend-borrower"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml}\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.ts --testPathPattern=tests/unit",
    "test:integration": "jest --config jest.config.ts --testPathPattern=tests/integration",
    "test:e2e": "jest --config jest.config.ts --testPathPattern=tests/e2e",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "infra:deploy": "cd infra && cdk deploy --all --require-approval never",
    "infra:destroy": "cd infra && cdk destroy --all --force",
    "infra:diff": "cd infra && cdk diff",
    "infra:synth": "cd infra && cdk synth",
    "dev:lender": "cd frontend-lender && npm run dev",
    "dev:borrower": "cd frontend-borrower && npm run dev",
    "dev:all": "concurrently \"npm run dev:lender\" \"npm run dev:borrower\"",
    "seed": "npx ts-node scripts/seed-demo-data.ts",
    "clean": "rm -rf node_modules dist build cdk.out coverage .tsbuildinfo",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:shell": "docker compose exec app bash",
    "preflight": "npm run lint && npm run format:check && npm run test:unit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "aws-cdk": "^2.1142.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
