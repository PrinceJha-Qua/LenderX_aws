# ============================================================
# LenderX .gitignore
# ============================================================

# ── Internal Team Documents (NOT for GitHub) ──
documents/

# ── Dependencies ──
node_modules/
.pnp
.pnp.js

# ── Build Outputs ──
dist/
build/
out/
cdk.out/
.next/

# ── TypeScript ──
*.tsbuildinfo
*.js.map
*.d.ts
!jest.config.ts
!vitest.config.ts
!vite.config.ts
!cdk.json

# ── Testing ──
coverage/
.nyc_output/
test-results/
junit.xml

# ── Environment ──
.env
.env.local
.env.*.local
!.env.example

# ── AWS ──
.aws-sam/
samconfig.toml
cdk.context.json

# ── Python (scripts/venv) ──
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# ── Docker ──
.docker/

# ── IDE ──
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──
*.tgz
.cache/
tmp/
temp/
