# ============================================================
# LenderX Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
AWS_PROFILE=lenderx

# Cognito (populated after CDK deploy)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# API (populated after CDK deploy)
API_ENDPOINT=

# Bedrock — Nova Micro for development ($0.035/$0.14 per 1M tokens)
# Swap to Haiku 4.5 for demo day only ($1/$5 per 1M tokens)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID_DEMO=anthropic.claude-haiku-4-5-v1:0

# App Config
STAGE=dev
LOG_LEVEL=debug

# Frontend
VITE_API_ENDPOINT=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
